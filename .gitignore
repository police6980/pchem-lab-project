.env
.env.local
.env.*.local

# OS 시스템 파일
.DS_Store
Thumbs.db
desktop.ini

# 에디터 설정
.vscode/
.idea/
*.swp
*.swo
*~

# 아두이노 빌드 파일
firmware/**/build/
firmware/**/*.hex
firmware/**/*.bin
firmware/**/*.elf

