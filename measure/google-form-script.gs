/**
 * 기체 개념 진단 검사지 → Google 설문지 자동 생성 스크립트
 *
 * 사용법:
 *  1) https://script.google.com 접속 → "새 프로젝트"
 *  2) 이 파일 전체를 코드 영역에 붙여넣기
 *  3) 상단에서 함수 createGasConceptForm 선택 → "실행"
 *  4) 처음 실행 시 Google 계정 권한 허용
 *  5) 실행 로그(Ctrl+Enter 또는 "실행 기록")에 찍힌 편집 URL을 열면 완성된 설문지
 *
 *  ※ 그림 문항(아래 fig:true 표시 — 그래프/입자 그림 3개)은 설문지가
 *    텍스트 보기로 먼저 만들어진다. 더 정확히 하려면 설문지 편집기에서
 *    각 보기에 이미지(검사지-신규문항.html의 SVG를 PNG로 저장)를 추가한다.
 *    (Google 설문지는 SVG를 직접 지원하지 않으므로 PNG/JPG로 변환 필요)
 */
function createGasConceptForm() {
  var form = FormApp.create('기체 개념 진단 검사지');
